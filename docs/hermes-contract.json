    "local_services": "require_explicit_operator_override"
  },
  "policies": {
    "workflow": "conversation-driven",
    "background_self_improvement": false,
    "self_evolution": {
      "enabled": true,
      "scope": "verified_system_improvement",
      "trigger": ["specialist evolution handoff", "observed skill failure", "validated better path", "explicit audit"],
      "automatic_when": [
        "the current conversation provides evidence",
        "the improvement is reversible and narrowly scoped",
        "the relevant replay, test, or validator passes",
        "confidence >= 0.9 or the same issue is observed twice",
        "a concrete failure uses the failure-to-repair protocol before no_change"
      ],
      "persist_to": "canonical source plus D1 self_improvement_runs receipt; hermes_memory only for durable profile or skill_procedure evidence",
      "skill_source_edits": "automatic_after_replay_or_test_gate_in_active_conversation",
      "code_schema_workflow_edits": "automatic_after_full_verification_in_active_conversation",
      "deployment": "automatic_after_release_verification_with_observed_live_smoke",
      "never": ["unverified rules", "silent policy weakening", "destructive deletion", "external publication", "scheduled self-improvement", "background self-improvement"]
    },
    "feedback": "preserve exact reflection, then record proposals or evidence-backed no_change; auto-apply only through profile_v2 policy and never recommend",
    "recommendation_objective": "learning_value_v2: available rating 25%, explicit disposition 25%, strongest downstream evidence 50%; administrative exclusion and not_now are non-utility",
    "profile_automation": "automatic at confidence >= 0.8 with direct user statement or two evidence items; explicit assertion supersession requires direct contradiction or confidence >= 0.95 with three evidence items; all changes reversible",
    "notebooklm": "explicit feedback grounding or explicit Studio request only",
    "visual_batches": "one Arabic canonical content body per source, complete semantic evidence coverage, optional none|selected visual decision without stored palettes, deterministic content/render validation, actual page inspection, and automatic serialized publication only after pass",
    "recommendations": "explicit request only; feedback never creates a recommendation",
    "ai_routing": {
      "basic_intro": "inbox",
      "corporate_pr": "reject_or_inbox",
      "practical_applied_tool": "recommendation_allowed",
      "major_release_or_hardware_analysis": "recommendation_allowed",
      "training_internals_theory": "reject"
    }
  },
  "side_effect_tiers": {
    "automatic": {
      "requires": "active conversation plus profile_v2 evidence policy, or fully verified reversible system change",
      "allows": ["profile", "map", "scoring", "feedback receipts", "durable job completion", "verified skills", "verified prompts", "verified code", "verified tests", "additive schema migrations", "verified workflows", "verified Learning Compass deployment"]
    },
    "proposal_only": {
      "requires": "reviewable proposal and evidence receipt",
      "allows": ["broad or insufficiently verified skills", "prompts", "code", "tests", "schema", "runtime configuration"]
    },
    "explicit_only": {
      "requires": "separate explicit user instruction for the exact target",
      "allows": ["destructive deletion", "external publication"]
    }
  },
  "specialist_receipt": ["intent", "target", "before", "mutation_or_job", "after", "evidence", "blocker"],
