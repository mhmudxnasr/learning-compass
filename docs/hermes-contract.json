  "policies": {
    "workflow": "conversation-driven",
    "background_self_improvement": false,
    "self_evolution": {
      "enabled": true,
      "scope": "verified_system_improvement",
      "trigger": ["specialist evolution handoff", "observed skill failure", "validated better path", "explicit audit"],
      "automatic_when": [
        "the current conversation provides evidence",
        "the improvement is reversible and narrowly scoped",
        "the relevant replay, test, or validator passes",
        "confidence >= 0.9 or the same issue is observed twice",
        "a concrete failure uses the failure-to-repair protocol before no_change"
      ],
      "persist_to": "canonical source plus D1 self_improvement_runs receipt; hermes_memory only for durable profile or skill_procedure evidence",
      "skill_source_edits": "automatic_after_replay_or_test_gate_in_active_conversation",
      "code_schema_workflow_edits": "automatic_after_full_verification_in_active_conversation",
      "deployment": "automatic_after_release_verification_with_observed_live_smoke",
      "never": ["unverified rules", "silent policy weakening", "destructive deletion", "external publication", "scheduled self-improvement", "background self-improvement"]
    },
    "feedback": "preserve the exact reflection plus completion_state, reason_tags, expected, actual, effort, length_minutes, rating, and separate disposition; in_progress/not_now is neutral, stopped requires a reason, Compass exposure retains branch/domain/lane/target context, every write returns a receipt, proposals or evidence-backed no_change follow profile_v2 policy, and feedback never recommends",
    "recommendation_objective": "learning_value_v2: available rating 25%, explicit disposition 25%, strongest downstream evidence 50%; administrative exclusion and not_now are non-utility",
    "profile_automation": "automatic at confidence >= 0.8 with direct user statement or two evidence items; explicit assertion supersession requires direct contradiction or confidence >= 0.95 with three evidence items; all changes reversible",
    "notebooklm": "explicit feedback grounding or explicit Studio request only",
    "notebooklm_learning": "hard source-grounded quiz by default; concept-fit media only; indexed, pending, ready, and failed provider states use canonical agent receipts",
    "visual_batches": "Visual Lite only: one canonical Arabic semantic HTML article plus A4 PDF printed from it; source acquisition is gated by a complete lite-visual-source-extraction/v1 receipt from extract_source.py; hash-verified cache, Readability/Playwright, YouTube captions/yt-dlp/Whisper, PyMuPDF/Tesseract, EPUB spine, Pandoc, and direct text are the owned adapters; Intent and Frontend Design reasoning; gapless checksum-bound source scopes; semantic HTML, source-specific CSS, native structures, and rare inline SVG only; no Visual Mind delegation, templates, presets, mind maps, raster/generated images, image agents, scripts, widgets, or mandatory pauses; exact checkpoint evidence, deterministic hash-bound validation, and atomic pair publication",
    "recommendations": "explicit request only; feedback never creates a recommendation",
    "capture": "every new source is a captured Library record with its validated branch persisted atomically; Queue is separate and explicit",
    "personal_library": "typed books and media use canonical branch-verified records with editable personal state and append-only lineage; personal status never enters Queue or advances learning",
    "learning_progression": "Levels and Threads advance only through learner-confirmed direct lesson completion; projects, sources, notes, ratings, dispositions, recall, resurfacing, frontier states, and provider receipts never gate or advance progression",
    "resurfacing": "Daily resurfacing is a passive source-review loop with explicit star, reviewed, snooze, and dismiss controls; frequency decay and seven-day suppression never alter taste, mastery, Queue, or lesson state",
    "semantic_relationships": "Meaningful backlinks, cross-branch bridges, and contradiction review derive from anchored typed Learning Unit relations with canonical branch ownership; keyword overlap never creates a relationship",
    "note_distillation": "Progressive distillation is explicit and additive: checksum-bound claim highlights, append-only user synthesis revisions, and anchored Unit promotion never rewrite canonical note text",
    "contextual_delivery": "Device, time, energy, language, context, depth, and perspective signals are explicit or source-grounded advisory inputs; unknown is neutral and Queue order remains canonical",
    "branch_domain": "every captured, recommended, or queued item requires a verified non-pruned branch plus persisted super_category/domain and a visible branch pill on every rendering surface; synthetic rounds are retired",
    "ai_routing": {
      "basic_intro": "capture_only",
      "corporate_pr": "reject_or_capture_on_explicit_request",
      "practical_applied_tool": "recommendation_allowed",
      "major_release_or_hardware_analysis": "recommendation_allowed",
      "training_internals_theory": "reject"
    }
  },
  "side_effect_tiers": {
    "automatic": {
      "requires": "active conversation plus profile_v2 evidence policy, or fully verified reversible system change",
      "allows": ["profile", "map", "scoring", "feedback receipts", "durable job completion", "verified skills", "verified prompts", "verified code", "verified tests", "additive schema migrations", "verified workflows", "verified Learning Compass deployment"]
    },
    "proposal_only": {
      "requires": "reviewable proposal and evidence receipt",
      "allows": ["broad or insufficiently verified skills", "prompts", "code", "tests", "schema", "runtime configuration"]
    },
    "explicit_only": {
      "requires": "separate explicit user instruction for the exact target",
      "allows": ["destructive deletion", "external publication"]
    }
  },
