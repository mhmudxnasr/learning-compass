{
  "name": "learning-compass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "vite build",
    "check": "npm run quality && npm test && npm run build",
    "dead-code": "knip --include files,dependencies,unlisted",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --config eslint.config.js .",
    "quality": "npm run lint && npm run dead-code && npm run format:check",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:unit:portable": "node --test $(find tests/unit -name '*.test.ts' ! -name 'transcript-adapter.test.ts' ! -name 'lite-visual-source-extraction.test.ts' ! -name 'lite-visual-validator.test.ts' ! -name 'lite-visual-hardening.test.ts')",
    "test:integration": "for file in tests/integration/*.mjs; do node \"$file\" || exit; done",
    "test:e2e": "node tests/e2e/routes.mjs",
    "verify:hermes": "node scripts/verify-hermes-contract.mjs && python3 scripts/verify-hermes-prompt.py",
    "verify:agent-contract": "node --test tests/unit/agent-control.test.ts && node scripts/verify-hermes-contract.mjs",
    "verify:migrations": "node scripts/rehearse-migrations.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "export:recovery": "node scripts/export-recovery.mjs",
    "backup:production": "node scripts/backup-production.mjs",
    "rehearse:recovery": "node scripts/rehearse-recovery.mjs",
    "install:backup-timer": "bash scripts/install-backup-timer.sh",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "test": "npm run test:unit && npm run typecheck",
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler d1 execute recommendations-db --local --config wrangler.toml --file schema.sql && wrangler d1 migrations apply recommendations-db --local --config wrangler.toml && npm run build && wrangler dev --config wrangler.toml --var ALLOW_UNAUTHENTICATED_LOCAL_WRITES:true",
    "deploy": "node scripts/deploy-release.mjs",
    "verify:budget": "node scripts/verify-budget-policy.mjs",
    "release:status": "node scripts/release-status.mjs"
  },
  "dependencies": {
    "cytoscape": "^3.34.2",
    "hono": "^4.13.5",
    "preact": "^10.29.8",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@eslint/js": "^10.0.1",
    "@mozilla/readability": "^0.6.0",
    "@preact/preset-vite": "^2.10.2",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
}
